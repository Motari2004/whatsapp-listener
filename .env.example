# Port the server listens on (Render sets this automatically, ignore in production)
PORT=3000

# Where the WhatsApp session is persisted. On Render this should point into
# your mounted disk, e.g. /data/.wwebjs_auth
SESSION_PATH=./.wwebjs_auth

# Long random string required as ?token=... to view /, /qr, /status, /messages.
# Leave blank locally for convenience, but ALWAYS set this in production —
# without it, anyone with your URL could scan your QR page and hijack the link.
DASHBOARD_TOKEN=

# Optional: POST every incoming message as JSON to this URL
WEBHOOK_URL=
